<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE tiles-definitions PUBLIC
   "-//Apache Software Foundation//DTD Tiles Configuration 2.0//EN"
   "http://tiles.apache.org/dtds/tiles-config_2_0.dtd">

<!-- Tutorial : https://www.tutorialspoint.com/struts_2/struts_tiles.htm -->

<tiles-definitions>

	<!-- BASE LAYOUT -->
	<definition name="baseLayout"
		template="/pages-back/_layout/baseLayout.jsp">
		<put-attribute name="title" value="Base Layout" />
		<put-attribute name="header"
			value="/pages-back/_layout/header.jsp" />
		<put-attribute name="menu"
			value="/pages-back/_layout/menu.jsp" />
		<put-attribute name="body"
			value="/pages-back/_layout/body.jsp" />
		<put-attribute name="footer"
			value="/pages-back/_layout/footer.jsp" />
	</definition>
	
	<!-- BLANK TEMPLATE -->
	<definition name="blankTemplate" extends="baseLayout">
		<put-attribute name="title" value="Blank Template"/>
		<put-attribute name="body"
			value="/pages-back/_layout/blank_template.jsp" />
	</definition>
	
	<!-- DASHBOARD -->
	<definition name="demoDashboard" extends="baseLayout">
		<put-attribute name="title" value="Demo Dashboard"/>
		<put-attribute name="body"
			value="/pages-back/dashboard/demo_dashboard.jsp" />
	</definition>
	
	<!-- TABLE -->
	<definition name="demoTable" extends="baseLayout">
		<put-attribute name="title" value="Demo Table"/>
		<put-attribute name="body"
			value="/pages-back/table/demo_table.jsp"/>
	</definition>
	
	<!-- FORGET PASSWORD (standalone page) -->
	<definition name="forgetPassword" template="/pages-back/forget_password/forget_password.jsp">
	    <put-attribute name="title" value="Forget Password"/>
	</definition>
	
	<!-- RESET PASSWORD -->
	<definition name="resetPassword" extends="baseLayout">
		<put-attribute name="title" value="Reset Password"/>
		<put-attribute name="body" value="/pages-back/forget_password/reset_password.jsp" />
	</definition>

	<!-- FORGET PASSWORD SUCCESS (standalone page) -->
	<definition name="resetPasswordSuccess" template="/pages-back/forget_password/reset_password_success.jsp">
	    <put-attribute name="title" value="Reset Password Success"/>
	</definition>
	
	<!-- HOLIDAY -->
	<definition name="holidayList" extends="baseLayout">
		<put-attribute name="title" value="Holiday List"/>
		<put-attribute name="body"
			value="/pages-back/holiday/holiday_newlist.jsp" />
	</definition>
	
	<definition name="holidayAdd" extends="baseLayout">
		<put-attribute name="title" value="Holiday Add"/>
		<put-attribute name="body"
			value="/pages-back/holiday/holiday_add.jsp" />
	</definition>
	
	<definition name="holiday_edit" extends="baseLayout">
		<put-attribute name="title" value="Holiday Edit" />
		<put-attribute name="body"
			value="/pages-back/holiday/holiday_edit.jsp" />
	</definition>

	<!-- CHECK-IN/CHECK-OUT -->
	<definition name="checkInOut" extends="baseLayout">
		<put-attribute name="title" value="Check-In/Check-Out"/>
		<put-attribute name="body"
			value="/pages-back/check/check_in_out.jsp"/>
	</definition>
	
</tiles-definitions>