<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE tiles-definitions PUBLIC
   "-//Apache Software Foundation//DTD Tiles Configuration 2.0//EN"
   "http://tiles.apache.org/dtds/tiles-config_2_0.dtd">

<!-- Tutorial : https://www.tutorialspoint.com/struts_2/struts_tiles.htm -->

<tiles-definitions>
	<!-- BASE LAYOUT -->
	<definition name="baseLayout"
		template="/pages-back/_layout/baseLayout.jsp">
		<put-attribute name="title" value="Base Layout" />
		<put-attribute name="header"
			value="/pages-back/_layout/header.jsp" />
		<put-attribute name="menu"
			value="/pages-back/_layout/menu.jsp" />
		<put-attribute name="body"
			value="/pages-back/_layout/body.jsp" />
		<put-attribute name="footer"
			value="/pages-back/_layout/footer.jsp" />
	</definition>
	
	<!-- BLANK TEMPLATE -->
	<definition name="blankTemplate" extends="baseLayout">
		<put-attribute name="title" value="Blank Template"/>
		<put-attribute name="body"
			value="/pages-back/_layout/blank_template.jsp" />
	</definition>
	
	<!-- DASHBOARD -->
	<definition name="demoDashboard" extends="baseLayout">
		<put-attribute name="title" value="Demo Dashboard"/>
		<put-attribute name="body"
			value="/pages-back/dashboard/demo_dashboard.jsp" />
	</definition>
</tiles-definitions>