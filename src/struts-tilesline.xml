<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE tiles-definitions PUBLIC
   "-//Apache Software Foundation//DTD Tiles Configuration 2.0//EN"
   "http://tiles.apache.org/dtds/tiles-config_2_0.dtd">

<!-- Tutorial : https://www.tutorialspoint.com/struts_2/struts_tiles.htm -->

<tiles-definitions>

	<!-- BASE LAYOUT -->
	<definition name="baseLayout"
		template="/pages-line/_layout/baseLayout.jsp">
		<put-attribute name="title" value="Base Layout" />
		<put-attribute name="header"
			value="/pages-line/_layout/header.jsp" />
		<put-attribute name="menu"
			value="/pages-line/_layout/menu.jsp" />
		<put-attribute name="body"
			value="/pages-line/_layout/body.jsp" />
		<put-attribute name="footer"
			value="/pages-line/_layout/footer.jsp" />
	</definition>

	<!-- CHECK-IN/CHECK-OUT -->
	<definition name="line_checkInOut" extends="baseLayout">
		<put-attribute name="title" value="Check-In/Check-Out" />
		<put-attribute name="body"
			value="/pages-line/check/check_in_out.jsp" />
	</definition>
	
	<!-- Check All Calendar -->
	<definition name="line_NewCheckAllCalendar" extends="baseLayout">
		<put-attribute name="title" value="Check All Calendar" />
		<put-attribute name="body"
			value="/pages-line/calendar/new_checkall_calendar.jsp" />
	</definition>
	
	<!-- My Leave -->
	<definition name="line_new_myleave_list" extends="baseLayout">
		<put-attribute name="title" value="My Leave List" />
		<put-attribute name="body"
			value="/pages-line/leave/my_leave_list.jsp" />
	</definition>
	
	<!-- Add Leave Page -->
	<definition name="line_newLeaveAdd" extends="baseLayout">
		<put-attribute name="title" value="Add Leave" />
		<put-attribute name="body"
			value="/pages-line/leave/new_leavePage.jsp" />
	</definition>
	<!-- Add Leave Page -->

	<!-- Edit Page -->
	<definition name="line_newLeaveEdit" extends="baseLayout">
		<put-attribute name="title" value="Edit Leave" />
		<put-attribute name="body"
			value="/pages-line/leave/new_leavePage.jsp" />
	</definition>
	<!-- Edit Page -->

	<!-- File -->
	<definition name="line_previewFile"
		template="/pages-line/leave/preview_file.jsp">
		<put-attribute name="title" value="Preview File" />
	</definition>
	<!-- File -->
	<!-- My Leave -->

	<!-- Line OA -->
	<definition name="line_bind_account" template="/pages-line/LineOA/BindAccountLineOA.jsp">
		<put-attribute name="title" value="Bind Account" />
		<put-attribute name="body"
			value="/pages-line/LineOA/BindAccountLineOA.jsp" />
	</definition>
	<!-- Line OA -->

</tiles-definitions>