		<variableExpression><![CDATA[String.valueOf($F{dt_start}) + "|" + String.valueOf($F{dt_end}) + "|" + $F{from_location} + "|" + $F{to_location} + "|" + $F{expense_description}]]></variableExpression>
	</variable>
