	<subDataset name="Table Dataset 1" uuid="16d18dc3-129c-484c-b3d9-299c27265b56"/>
	<parameter name="logoPath" class="java.lang.Object" isForPrompting="false">
		<parameterDescription><![CDATA[The letterhead image]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="expenseGroupId" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="basePath" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select 
	    ed.expense_detail_id,
	    ed.total,
	    ed.description as description_detail,
	    eg.approved_at,
	    eg.status_id,
	    eg.description_appr,
	    eg.requested_at,
	    eg.received_at,
	    eg.time_create as eg_time_create,
	    e.from_location,
	    e.to_location,
	    e.description as expense_description,
	    e.dt_start,
	    e.dt_end,
	
	    ett.name as travel_type_name,
	
	 
	    u.name as user_name,
	    u.bank_number,
	    fu.file_id as file_user,
	    fu.type as type_file_user,
		fau.file_id as file_approve_user,
		fau.type as type_file_approve_user,
		au.name as approve_user_name
	
	from expense_detail ed
	left join expense e on ed.expense_id = e.expense_id
	left join expense_group eg on e.expense_group_id = eg.expense_group_id
	left join exp_travel_type ett on ett.exp_travel_type_id = ed.go_by
	left join user u on eg.user_id = u.id
	left join user au on eg.appr_user_id = au.id
	left join file fu on u.path_signature = fu.path
	left join file fau on au.path_signature = fau.path
	
	where eg.expense_group_id = $P{expenseGroupId}
	order by date(e.dt_start),
	    e.expense_id
	 ;]]>
	</queryString>
