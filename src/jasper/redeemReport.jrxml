	<parameter name="logoPath" class="java.lang.Object" isForPrompting="false"/>
	<parameter name="basePath" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="redeemId" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT
    ur.token,
    ur.cash,
    ur.description,
    ur.time_create,
    ur.time_approve,
    ur.time_deliver,
    ur.time_receive,

    u_owner.name AS user_name,
    u_owner.path_signature AS user_signature,
    u_owner.name_en AS user_name_en,
    u_owner.phone_num AS user_phone_number,
    pos.name AS user_pos,

    u_approve.name AS user_approve_name,
    u_approve.path_signature AS user_approve_signature,
    u_approve.position_id AS user_approve_position,
    u_approve.name_en AS user_approve_name_en,

    u_deliver.name AS user_deliver_name,
    u_deliver.path_signature AS user_deliver_signature,
    u_deliver.position_id AS user_deliver_position,
    u_deliver.name_en AS user_deliver_name_en,

    u_receive.name AS user_receive_name,
    u_receive.path_signature AS user_receive_signature,
    u_receive.position_id AS user_receive_position,
    u_receive.name_en AS user_receive_name_en,

    ip.product_id,
    ip.item_name,
    ip.details,
    
    p.product_no AS product_number

FROM cube.user_redeem ur

INNER JOIN cube.user u_owner
    ON u_owner.id = ur.user_id
    
LEFT JOIN cube.position pos
    ON pos.position_id = u_owner.position_id

INNER JOIN cube.user u_approve
    ON u_approve.id = ur.user_approve

INNER JOIN cube.user u_deliver
    ON u_deliver.id = ur.user_deliver

INNER JOIN cube.item_privilege ip
    ON ip.item_id = ur.item_id
    
LEFT JOIN cube.product p
 	ON ip.item_id = p.product_id

INNER JOIN cube.user u_receive
    ON u_receive.id = ur.user_receive

WHERE ur.user_redeem_id = $P{redeemId}]]>
	</queryString>
