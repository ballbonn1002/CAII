<!DOCTYPE struts PUBLIC
"-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
"http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
	<package name="Authorization" namespace="/" extends="default">
		<result-types>
			<result-type name="tiles"
				class="org.apache.struts2.views.tiles.TilesResult" />
		</result-types>
		<action name="authorization"
			class="com.cubesofttech.action.LoginAction" method="login">
			<!-- <result name="success" type="redirectAction">check_in?userId=${onlineUser.id} </result> -->
			<result name="success" type="redirectAction">demo_dashboard</result>
			<result name="error">/index.jsp</result>
			<!-- <result name="input" type="redirectAction">check_in?userId=${onlineUser.id} </result> -->
			<result name="input" type="redirectAction">demo_dashboard</result>
		</action>
	</package>
	<package name="UserAction" namespace="/"
		extends="default, json-default">
		<result-types>
			<result-type name="tiles"
				class="org.apache.struts2.views.tiles.TilesResult" />
		</result-types>
		<action name="blank_template"
			class="com.cubesofttech.action.NewsAction" method="demoDashboard">
			<result name="success" type="tiles">blankTemplate</result>
			<result name="error">/index.jsp</result>
		</action>
		<action name="demo_dashboard"
			class="com.cubesofttech.action.NewsAction" method="demoDashboard">
			<result name="success" type="tiles">demoDashboard</result>
			<result name="error">/index.jsp</result>
		</action>

		<action name="forget_password" class="com.cubesofttech.action.LoginAction" method="forgetPassword">
			<result name="success" type="tiles">forgetPassword</result>
			<result name="error">/index.jsp</result>
		</action>
		<action name="reset_password" class="com.cubesofttech.action.LoginAction" method="resetPassword">
			<result name="success" type="tiles">resetPasswordSuccess</result>
			<result name="error">/pages-back/common/error/error_500.jsp</result>
		</action>
		<action name="reset_password_success" class="com.cubesofttech.action.LoginAction" method="resetPasswordSuccess">
			<result name="success" type="tiles">resetPasswordSuccess</result>
			<result name="error">/index.jsp</result>
		</action>

		<action name="validate_user" class="com.cubesofttech.action.LoginAction" method="validateUserLogin">
			<result type="json" />
		</action>
		
		<!-- CHECK-IN/CHECK-OUT -->
		<action name="check_in_out"
			class="com.cubesofttech.action.WorkHoursAction" method="init">
			<result name="success" type="tiles">checkInOut</result>
			<result name="error">/index.jsp</result>
		</action>
		
		<action name="saveCheckInOut"
			class="com.cubesofttech.action.WorkHoursAction" method="savecheck">
			<result name="error">/index.jsp</result>
		</action>

		<action name="demo_table"
			class="com.cubesofttech.action.NewsAction" method="demoDashboard">
			<result name="success" type="tiles">demoTable</result>
			<result name="error">/index.jsp</result>
		</action>
		
		<!-- User -->
		<action name="user-list"
			class="com.cubesofttech.action.UserAction" method="list">
			<result name="success" type="tiles">user.list</result>
			<result name="error">/index.jsp</result>
		</action>
		<action name="update-user-status"
			class="com.cubesofttech.action.UserAction" method="updateUserStatus">
			<result name="json">/pages-back/common/json.jsp</result>
			<result name="error">/index.jsp</result>
		</action>
		<action name="user-edit"
			class="com.cubesofttech.action.UserAction" method="openEdit">
			<result name="success" type="tiles">admin_edit_userprofile</result>
			<result name="error">/index.jsp</result>
		</action>
		<action name="admin-perform-edit"
			class="com.cubesofttech.action.UserAction" method="performEdit">
			<result name="success" type="tiles">admin_edit_userprofile</result>
			<!-- <result name="input" type="tiles">admin_edit_userprofile</result> -->
			<result name="error">/index.jsp</result>
		</action>
		<!-- เพิ่ม function add -->
		<action name="user-perform-add"
			class="com.cubesofttech.action.UserAction" method="performAdd">
			<result name="success" type="redirectAction">user-edit?userId=${userId}
			</result>
			<result name="error" type="tiles">user.add</result>
		</action>
		<!-- Search User with Ajax -->
		<action name="search-User"
			class="com.cubesofttech.action.UserAction" method="searchUser">
			<result name="error">/index.jsp</result>
			<result name="success" type="json">user_list</result>
		</action>
		<!-- Holiday -->
		<action name="holiday_list"
			class="com.cubesofttech.action.HolidayAction" method="List">
			<result name="success" type="tiles">holidayList</result>
			<result name="error">/index.jsp</result>
		</action>
		
		<action name="holiday_add"
			class="com.cubesofttech.action.HolidayAction" method="formadd">
			<result name="success" type="tiles">holidayAdd</result> <!-- Definition หน้า JSP -->
			<result name="error">/index.jsp</result>
		</action>
		
		<action name="AddHoliday"
			class="com.cubesofttech.action.HolidayAction" method="Add">
			<result name="success" type="chain">holiday_list</result> <!-- type = "chain" เป้นการส่งให้ชื่อ Action นั่นทำงาน -->
			<result name="error" type="tiles">/error.jsp</result>
			<result name="input" type="tiles">holidayAdd</result>
		</action>
	
	<action name="holiday_edit"
			class="com.cubesofttech.action.HolidayAction" method="Edit">
			<result name="success" type="tiles">holiday_edit</result>
			<result name="error">/index.jsp</result>
	</action>
	
	<action name="UpdateHoliday"
  class="com.cubesofttech.action.HolidayAction" method="Update">
  <result name="success" type="redirectAction">holiday_list</result>
  <result name="input"   type="tiles">holiday_edit</result>
  <result name="error">/index.jsp</result>
</action>

	
	<action name="DeleteHoliday"
			class="com.cubesofttech.action.HolidayAction" method="Delete">
			<result name="success" type="chain">holiday_list</result>
			<result name="error">/index.jsp</result>
	</action>
	
	<action name="SearchHoliday"
			class="com.cubesofttech.action.HolidayAction" method="searchtable">
			<result name="success" type="tiles">holiday_newlist</result>
			<result name="error">/index.jsp</result>
	</action>
		

		
	</package>
</struts>